free:
javascript:(function(){if(window.agarGameActive)return;window.agarGameActive=true;const WORLD=9000;const SAVE_KEY='agar_dom_save_v1';let save={coins:0,unlocked:['classic'],skin:'classic',color:'#00d2ff',nick:'Player'};try{const s=JSON.parse(localStorage.getItem(SAVE_KEY));if(s)save={...save,...s};}catch(e){}const persist=()=>{try{localStorage.setItem(SAVE_KEY,JSON.stringify(save));}catch(e){}};const skins=[{id:'classic',name:'Classic',cost:0},{id:'ring',name:'Neon Ring',cost:25},{id:'target',name:'Bullseye',cost:60},{id:'core',name:'Cyber Core',cost:120},{id:'solar',name:'Solar Flare',cost:250}];const colors=['#00d2ff','#ff4757','#2ed573','#ffa502','#a29bfe','#ff6b81','#eccc68','#1e90ff'];const playerNames=['Kairo','Vortex','Nova','Zeph','Apex','Orbit','Luna','Shadow','Blaze','Sora','Echo','Titan','Nyx','Rift','Pixel','Koda','Aero','Jinx','Milo','Vex','Sol','drifter','xX_Pro_Xx','Ghost'];const c=document.createElement('canvas');c.style.cssText='position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:999998;background:#0b0e14;';document.body.appendChild(c);const ctx=c.getContext('2d');let w=c.width=innerWidth,h=c.height=innerHeight;addEventListener('resize',()=>{w=c.width=innerWidth;h=c.height=innerHeight;});const ui=document.createElement('div');ui.style.cssText='position:fixed;inset:0;z-index:999999;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at center,rgba(16,22,34,0.85),rgba(7,9,14,0.96));backdrop-filter:blur(8px);font:14px system-ui,-apple-system,sans-serif;color:#fff;';document.body.appendChild(ui);const hud=document.createElement('div');hud.style.cssText='display:none;position:fixed;top:16px;right:16px;z-index:999999;background:rgba(15,19,28,0.86);backdrop-filter:blur(6px);color:#fff;padding:14px 18px;border-radius:12px;font:13px/1.55 system-ui,sans-serif;min-width:190px;border:1px solid rgba(255,255,255,0.1);box-shadow:0 12px 32px rgba(0,0,0,0.45);';document.body.appendChild(hud);let playing=false,lastRun=null;const cleanup=()=>{window.agarGameActive=false;playing=false;c.remove();ui.remove();hud.remove();};function renderMenu(){const deathBanner=lastRun?`<div style="background:linear-gradient(135deg,rgba(255,71,87,0.18),rgba(255,165,2,0.15));border:1px solid rgba(255,165,2,0.35);border-radius:10px;padding:10px 12px;margin-bottom:16px;text-align:left;font-size:12px;"><div style="font-weight:700;color:#ff6b81;margin-bottom:3px;">Eliminated by ${lastRun.killer}</div><div style="display:flex;justify-content:space-between;color:#ddd;"><span>Peak Mass: <b>${lastRun.peak}</b></span><span style="color:#ffd32a;font-weight:700;">+${lastRun.earned} Coins</span></div></div>`:'';ui.innerHTML=`<div style="background:linear-gradient(180deg,#171d29,#111620);padding:28px 30px;border-radius:20px;border:1px solid rgba(255,255,255,0.12);width:370px;box-shadow:0 25px 60px rgba(0,0,0,0.75);position:relative;"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;"><div style="background:rgba(255,211,42,0.14);border:1px solid rgba(255,211,42,0.35);color:#ffd32a;padding:5px 12px;border-radius:20px;font-weight:700;font-size:13px;">&#129689; ${save.coins} Coins</div><div style="font-size:11px;color:#2ed573;display:flex;align-items:center;gap:5px;"><span style="width:7px;height:7px;border-radius:50%;background:#2ed573;display:inline-block;"></span>19 Online</div><span id="ag-close" style="cursor:pointer;font-size:22px;line-height:1;opacity:0.55;padding:0 4px;">&times;</span></div><div style="text-align:center;margin-bottom:18px;"><h1 style="margin:0;font-size:32px;font-weight:900;letter-spacing:1.5px;background:linear-gradient(90deg,#00d2ff,#7bed9f);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">AGAR.IO</h1><div style="font-size:12px;opacity:0.55;margin-top:2px;">EU-West Arena &bull; 9000x9000</div></div>${deathBanner}<div style="margin-bottom:14px;"><label style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:0.8px;opacity:0.6;margin-bottom:6px;">Nickname</label><input id="ag-nick" type="text" maxlength="15" value="${save.nick}" placeholder="Enter nickname..." style="width:100%;box-sizing:border-box;padding:11px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.15);background:#0b0e14;color:#fff;font-size:14px;font-weight:600;outline:none;"/></div><div style="margin-bottom:16px;"><label style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:0.8px;opacity:0.6;margin-bottom:6px;">Cell Color</label><div id="ag-cols" style="display:flex;justify-content:space-between;gap:6px;"></div></div><div style="margin-bottom:20px;"><label style="display:block;font-size:11px;text-transform:uppercase;letter-spacing:0.8px;opacity:0.6;margin-bottom:6px;">Skins Shop</label><div id="ag-skins" style="display:grid;grid-template-columns:repeat(3,1fr);gap:7px;"></div></div><button id="ag-play" style="width:100%;padding:13px;border:none;border-radius:11px;background:linear-gradient(135deg,#00d2ff,#007aff);color:#fff;font-weight:800;font-size:16px;letter-spacing:0.5px;cursor:pointer;box-shadow:0 8px 20px rgba(0,122,255,0.35);">PLAY NOW</button><div style="margin-top:12px;text-align:center;font-size:11px;opacity:0.5;">Mouse: Move &bull; Space: Split &bull; W: Eject Mass</div></div>`;document.getElementById('ag-close').onclick=cleanup;const colWrap=document.getElementById('ag-cols');colors.forEach(col=>{const d=document.createElement('div');const sel=save.color===col;d.style.cssText=`width:28px;height:28px;border-radius:50%;background:${col};cursor:pointer;box-sizing:border-box;border:3px solid ${sel?'#fff':'transparent'};transform:${sel?'scale(1.12)':'scale(1)'};transition:0.15s;`;d.onclick=()=>{save.color=col;persist();renderMenu();};colWrap.appendChild(d);});const skinWrap=document.getElementById('ag-skins');skins.forEach(sk=>{const owned=save.unlocked.includes(sk.id);const active=save.skin===sk.id;const btn=document.createElement('div');btn.style.cssText=`padding:8px 6px;border-radius:9px;text-align:center;cursor:pointer;font-size:11px;border:1px solid ${active?'#00d2ff':owned?'rgba(255,255,255,0.16)':'rgba(255,211,42,0.3)'};background:${active?'rgba(0,210,255,0.16)':'rgba(255,255,255,0.04)'};`;btn.innerHTML=`<div style="font-weight:700;margin-bottom:2px;">${sk.name}</div><div style="color:${active?'#00d2ff':owned?'#7bed9f':'#ffd32a'};font-weight:600;">${active?'Equipped':owned?'Select':sk.cost+' &#129689;'}</div>`;btn.onclick=()=>{if(owned){save.skin=sk.id;persist();renderMenu();}else if(save.coins>=sk.cost){save.coins-=sk.cost;save.unlocked.push(sk.id);save.skin=sk.id;persist();renderMenu();}};skinWrap.appendChild(btn);});document.getElementById('ag-play').onclick=()=>{const val=document.getElementById('ag-nick').value.trim();save.nick=val||'Player';persist();ui.style.display='none';hud.style.display='block';startGame();};}const rCol=()=>colors[Math.floor(Math.random()*colors.length)];const massToR=m=>Math.sqrt(m)*4.6;let mx=w/2,my=h/2;onmousemove=e=>{mx=e.clientX;my=e.clientY;};let foods=[],ejected=[],playerCells=[],rivals=[],shieldUntil=0,peakMass=30,cam={x:WORLD/2,y:WORLD/2,zoom:1};const types=['aggressive','passive','stupid','balanced'];const spawnRival=(idx)=>{const t=types[idx%types.length];return{x:Math.random()*WORLD,y:Math.random()*WORLD,m:20+Math.random()*75,c:rCol(),name:playerNames[(idx*3+Math.floor(Math.random()*5))%playerNames.length],ai:t,tx:Math.random()*WORLD,ty:Math.random()*WORLD,timer:0,skin:skins[Math.floor(Math.random()*skins.length)].id};};function startGame(){foods=Array.from({length:950},()=>({x:Math.random()*WORLD,y:Math.random()*WORLD,c:rCol(),m:1.8}));ejected=[];playerCells=[{x:600+Math.random()*(WORLD-1200),y:600+Math.random()*(WORLD-1200),m:30,vx:0,vy:0,mergeAt:0}];peakMass=30;shieldUntil=Date.now()+5000;rivals=Array.from({length:18},(_,i)=>spawnRival(i));playing=true;requestAnimationFrame(loop);}onkeydown=e=>{if(!playing)return;const wx=cam.x+(mx-w/2)/cam.zoom,wy=cam.y+(my-h/2)/cam.zoom;if(e.code==='Space'){e.preventDefault();if(playerCells.length>=8)return;const added=[];playerCells.forEach(p=>{if(p.m>=38){p.m/=2;const a=Math.atan2(wy-p.y,wx-p.x);added.push({x:p.x+Math.cos(a)*massToR(p.m),y:p.y+Math.sin(a)*massToR(p.m),m:p.m,vx:Math.cos(a)*20,vy:Math.sin(a)*20,mergeAt:Date.now()+11000});}});playerCells.push(...added);}else if(e.code==='KeyW'){playerCells.forEach(p=>{if(p.m>=26){p.m-=4;const a=Math.atan2(wy-p.y,wx-p.x),r=massToR(p.m);ejected.push({x:p.x+Math.cos(a)*(r+6),y:p.y+Math.sin(a)*(r+6),vx:Math.cos(a)*16,vy:Math.sin(a)*16,c:save.color,m:3.6});}});}};function drawCell(x,y,r,col,name,skin,shield,now){ctx.save();const g=ctx.createRadialGradient(x-r*0.25,y-r*0.25,r*0.1,x,y,r);g.addColorStop(0,col);g.addColorStop(1,'#090c12');ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=col;ctx.fill();ctx.lineWidth=Math.max(2.5,r*0.06);ctx.strokeStyle='rgba(255,255,255,0.28)';ctx.stroke();if(skin==='ring'){ctx.beginPath();ctx.arc(x,y,r*0.72,0,Math.PI*2);ctx.lineWidth=Math.max(2,r*0.08);ctx.strokeStyle='rgba(255,255,255,0.65)';ctx.stroke();}else if(skin==='target'){[0.7,0.4].forEach(s=>{ctx.beginPath();ctx.arc(x,y,r*s,0,Math.PI*2);ctx.lineWidth=Math.max(2,r*0.06);ctx.strokeStyle='rgba(255,255,255,0.55)';ctx.stroke();});}else if(skin==='core'){ctx.beginPath();ctx.arc(x,y,r*0.45,0,Math.PI*2);ctx.fillStyle='rgba(255,255,255,0.35)';ctx.fill();}else if(skin==='solar'){ctx.beginPath();ctx.arc(x,y,r+4,0,Math.PI*2);ctx.lineWidth=3;ctx.strokeStyle=col;ctx.globalAlpha=0.45;ctx.stroke();ctx.globalAlpha=1;}if(shield){ctx.beginPath();ctx.arc(x,y,r+9+Math.sin(now/110)*3,0,Math.PI*2);ctx.lineWidth=3.5;ctx.strokeStyle='#ffd32a';ctx.stroke();}ctx.fillStyle='#fff';ctx.shadowColor='rgba(0,0,0,0.75)';ctx.shadowBlur=4;ctx.font=`700 ${Math.max(12,Math.min(28,r*0.4))}px system-ui,sans-serif`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(name,x,y);ctx.restore();}function loop(){if(!window.agarGameActive||!playing)return;const now=Date.now(),hasShield=now<shieldUntil;let cx=0,cy=0,totM=0;playerCells.forEach(p=>{cx+=p.x*p.m;cy+=p.y*p.m;totM+=p.m;});if(totM>peakMass)peakMass=totM;cx/=totM;cy/=totM;const targetZoom=Math.max(0.38,Math.min(1.05,1.18-Math.pow(totM,0.18)*0.17));cam.x+=(cx-cam.x)*0.12;cam.y+=(cy-cam.y)*0.12;cam.zoom+=(targetZoom-cam.zoom)*0.08;ctx.clearRect(0,0,w,h);ctx.save();ctx.translate(w/2,h/2);ctx.scale(cam.zoom,cam.zoom);ctx.translate(-cam.x,-cam.y);ctx.strokeStyle='rgba(255,255,255,0.045)';ctx.lineWidth=1;const step=100,vW=(w/2)/cam.zoom+120,vH=(h/2)/cam.zoom+120;const startX=Math.max(0,Math.floor((cam.x-vW)/step)*step),endX=Math.min(WORLD,cam.x+vW);const startY=Math.max(0,Math.floor((cam.y-vH)/step)*step),endY=Math.min(WORLD,cam.y+vH);for(let gx=startX;gx<=endX;gx+=step){ctx.beginPath();ctx.moveTo(gx,startY);ctx.lineTo(gx,endY);ctx.stroke();}for(let gy=startY;gy<=endY;gy+=step){ctx.beginPath();ctx.moveTo(startX,gy);ctx.lineTo(endX,gy);ctx.stroke();}ctx.strokeStyle='#ff4757';ctx.lineWidth=8;ctx.strokeRect(0,0,WORLD,WORLD);foods.forEach(f=>{if(Math.abs(f.x-cam.x)>vW||Math.abs(f.y-cam.y)>vH)return;ctx.beginPath();ctx.arc(f.x,f.y,5.2,0,Math.PI*2);ctx.fillStyle=f.c;ctx.fill();});ejected.forEach(ej=>{ej.x=Math.max(10,Math.min(WORLD-10,ej.x+ej.vx));ej.y=Math.max(10,Math.min(WORLD-10,ej.y+ej.vy));ej.vx*=0.88;ej.vy*=0.88;ctx.beginPath();ctx.arc(ej.x,ej.y,8.5,0,Math.PI*2);ctx.fillStyle=ej.c;ctx.fill();});for(let i=0;i<playerCells.length;i++){for(let j=i+1;j<playerCells.length;j++){const a=playerCells[i],b=playerCells[j],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy),minD=massToR(a.m)+massToR(b.m);if(now>a.mergeAt&&now>b.mergeAt&&d<minD*0.6){a.m+=b.m;playerCells.splice(j,1);j--;continue;}if(d<minD&&d>0){const push=(minD-d)*0.08;a.x-=(dx/d)*push;a.y-=(dy/d)*push;b.x+=(dx/d)*push;b.y+=(dy/d)*push;}}}const wx=cam.x+(mx-w/2)/cam.zoom,wy=cam.y+(my-h/2)/cam.zoom;playerCells.forEach(p=>{const a=Math.atan2(wy-p.y,wx-p.x),dist=Math.hypot(wx-p.x,wy-p.y),spd=Math.max(1.7,6.0-Math.pow(p.m,0.22));if(dist>4){p.x+=Math.cos(a)*spd+p.vx;p.y+=Math.sin(a)*spd+p.vy;}p.vx*=0.88;p.vy*=0.88;p.x=Math.max(15,Math.min(WORLD-15,p.x));p.y=Math.max(15,Math.min(WORLD-15,p.y));foods.forEach((f,fi)=>{if(Math.hypot(p.x-f.x,p.y-f.y)<massToR(p.m)){p.m+=f.m;foods[fi]={x:Math.random()*WORLD,y:Math.random()*WORLD,c:rCol(),m:1.8};}});for(let ei=ejected.length-1;ei>=0;ei--){if(Math.hypot(p.x-ejected[ei].x,p.y-ejected[ei].y)<massToR(p.m)){p.m+=ejected[ei].m;ejected.splice(ei,1);}}});let killerName='Another Player';rivals.forEach((b,bi)=>{b.timer--;let targetX=b.tx,targetY=b.ty,override=false;const sense=b.ai==='aggressive'?520:b.ai==='passive'?380:b.ai==='stupid'?140:340;if(b.ai!=='stupid'){playerCells.forEach(p=>{const d=Math.hypot(p.x-b.x,p.y-b.y);if(d<sense){if(p.m>b.m*1.15){targetX=b.x-(p.x-b.x);targetY=b.y-(p.y-b.y);override=true;}else if(b.ai!=='passive'&&b.m>p.m*1.15&&!hasShield&&!override){targetX=p.x;targetY=p.y;override=true;}}});if(!override){rivals.forEach((b2,b2i)=>{if(bi===b2i)return;const d=Math.hypot(b2.x-b.x,b2.y-b.y);if(d<sense){if(b2.m>b.m*1.15){targetX=b.x-(b2.x-b.x);targetY=b.y-(b2.y-b.y);override=true;}else if(b.ai==='aggressive'&&b.m>b2.m*1.15&&!override){targetX=b2.x;targetY=b2.y;override=true;}}});}}if(!override&&b.timer<=0){if(b.ai==='stupid'){b.tx=Math.max(100,Math.min(WORLD-100,b.x+(Math.random()-0.5)*900));b.ty=Math.max(100,Math.min(WORLD-100,b.y+(Math.random()-0.5)*900));b.timer=18+Math.random()*25;}else{let best=foods[0],bd=99999;for(let k=0;k<22;k++){const f=foods[Math.floor(Math.random()*foods.length)],d=Math.hypot(f.x-b.x,f.y-b.y);if(d<bd){bd=d;best=f;}}b.tx=best.x;b.ty=best.y;b.timer=40+Math.random()*45;}}const a=Math.atan2(targetY-b.y,targetX-b.x),spdMult=b.ai==='aggressive'?1.08:b.ai==='stupid'?1.12:1.0,spd=Math.max(1.5,5.1-Math.pow(b.m,0.22))*spdMult;b.x=Math.max(15,Math.min(WORLD-15,b.x+Math.cos(a)*spd));b.y=Math.max(15,Math.min(WORLD-15,b.y+Math.sin(a)*spd));foods.forEach((f,fi)=>{if(Math.hypot(b.x-f.x,b.y-f.y)<massToR(b.m)){b.m+=f.m;foods[fi]={x:Math.random()*WORLD,y:Math.random()*WORLD,c:rCol(),m:1.8};}});rivals.forEach((b2,b2i)=>{if(bi!==b2i&&b.m>b2.m*1.15&&Math.hypot(b.x-b2.x,b.y-b2.y)<massToR(b.m)-massToR(b2.m)*0.4){b.m+=b2.m;rivals[b2i]=spawnRival(b2i);}});for(let pi=playerCells.length-1;pi>=0;pi--){const p=playerCells[pi],d=Math.hypot(p.x-b.x,p.y-b.y);if(p.m>b.m*1.15&&d<massToR(p.m)-massToR(b.m)*0.4){p.m+=b.m;rivals[bi]=spawnRival(bi);}else if(!hasShield&&b.m>p.m*1.15&&d<massToR(b.m)-massToR(p.m)*0.4){b.m+=p.m;killerName=b.name;playerCells.splice(pi,1);}}});if(playerCells.length===0){playing=false;const earned=Math.max(1,Math.floor(peakMass*0.05));save.coins+=earned;persist();lastRun={peak:Math.floor(peakMass),earned,killer:killerName};hud.style.display='none';ui.style.display='flex';renderMenu();return;}const all=[...rivals.map(b=>({...b,isP:false})),...playerCells.map(p=>({...p,c:save.color,name:save.nick,skin:save.skin,isP:true}))].sort((a,b)=>a.m-b.m);all.forEach(e=>{const r=massToR(e.m);if(Math.abs(e.x-cam.x)>vW+r||Math.abs(e.y-cam.y)>vH+r)return;drawCell(e.x,e.y,r,e.c,e.name,e.skin,e.isP&&hasShield,now);});ctx.restore();const mmSize=145,mmX=w-mmSize-16,mmY=h-mmSize-16;ctx.fillStyle='rgba(12,16,24,0.84)';ctx.fillRect(mmX,mmY,mmSize,mmSize);ctx.strokeStyle='rgba(255,255,255,0.18)';ctx.lineWidth=1;ctx.strokeRect(mmX,mmY,mmSize,mmSize);rivals.forEach(b=>{ctx.beginPath();ctx.arc(mmX+(b.x/WORLD)*mmSize,mmY+(b.y/WORLD)*mmSize,Math.max(2,Math.min(5.5,b.m/45)),0,Math.PI*2);ctx.fillStyle=b.c;ctx.fill();});playerCells.forEach(p=>{ctx.beginPath();ctx.arc(mmX+(p.x/WORLD)*mmSize,mmY+(p.y/WORLD)*mmSize,4,0,Math.PI*2);ctx.fillStyle='#fff';ctx.fill();});const pTotal=Math.floor(playerCells.reduce((s,p)=>s+p.m,0));const shieldTxt=hasShield?`<div style="color:#ffd32a;font-size:11px;margin-bottom:5px;font-weight:600;">&#128737; Spawn Shield: ${((shieldUntil-now)/1000).toFixed(1)}s</div>`:'';const board=[...rivals.map(b=>({n:b.name,m:Math.floor(b.m),me:false})),{n:save.nick,m:pTotal,me:true}].sort((a,b)=>b.m-a.m).slice(0,8);hud.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;border-bottom:1px solid rgba(255,255,255,0.12);padding-bottom:6px;"><div><div style="font-weight:800;font-size:14px;">Mass: ${pTotal}</div><div style="font-size:11px;color:#ffd32a;">&#129689; ${save.coins} (+${Math.max(1,Math.floor(peakMass*0.05))} on death)</div></div><div><span id="ag-menu-btn" style="cursor:pointer;font-size:12px;background:rgba(255,255,255,0.1);padding:3px 7px;border-radius:5px;margin-right:4px;">Menu</span><span id="ag-x" style="cursor:pointer;font-size:16px;opacity:0.7;">&times;</span></div></div>${shieldTxt}<div style="font-size:10px;text-transform:uppercase;letter-spacing:0.8px;opacity:0.5;margin-bottom:3px;">Leaderboard</div>`+board.map((b,i)=>`<div style="color:${b.me?save.color:'#ddd'};font-weight:${b.me?'700':'400'}">${i+1}. ${b.n} <span style="float:right;opacity:0.8">${b.m}</span></div>`).join('');document.getElementById('ag-x').onclick=cleanup;document.getElementById('ag-menu-btn').onclick=()=>{playing=false;hud.style.display='none';ui.style.display='flex';renderMenu();};requestAnimationFrame(loop);}renderMenu();})();

